---
import Base from '../../layouts/Base.astro';
import { isPublished } from '../../lib/posts';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', isPublished)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Blog: Tracking, Consent Mode und Google Ads" description="Praxiswissen zu Google Tag Manager, GA4, Google-Ads-Conversions und Consent Mode v2 für kleine und mittlere Unternehmen.">
  <section class="page-head narrow">
    <h1>Blog</h1>
    <p class="lead">Praxiswissen zu Tracking, Consent Mode und Google Ads. Verständlich erklärt, ohne Fachchinesisch.</p>
  </section>
  <div class="post-list narrow">
    {posts.map((p) => (
      <a class="card" href={`${base}/blog/${p.id}/`}>
        <div class="date">{p.data.date.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}</div>
        <h2 style="margin:4px 0 6px;font-size:22px">{p.data.title}</h2>
        <p class="muted" style="margin:0">{p.data.description}</p>
      </a>
    ))}
  </div>
</Base>
